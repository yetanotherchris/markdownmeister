{
  "name": "markdownmeister",
  "productName": "MarkdownMeister",
  "version": "1.8.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=12"
  },
  "packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node node_modules/electron/install.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "docs:dev": "vite --config docs/site/vite.config.ts",
    "docs:build": "vite build --config docs/site/vite.config.ts",
    "docs:preview": "vite preview --config docs/site/vite.config.ts",
    "docs:test:e2e": "npm run docs:build && playwright test --config playwright.docs.config.ts",
    "check": "node scripts/check-maintainability.mjs",
    "format:check": "prettier --check src tests scripts docs/site *.ts *.mjs package.json",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "lint": "eslint . --ext .ts,.tsx,.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p docs/site/tsconfig.json"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource/inter": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/kit": "^7.21.3",
    "chokidar": "^5.0.0",
    "lucide-react": "^1.28.0",
    "mdast-util-gfm-autolink-literal": "^2.0.1",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-extension-math": "^3.1.0",
    "nspell": "^2.1.5",
    "react": "^19.2.8",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "fast-xml-parser": "^5.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
